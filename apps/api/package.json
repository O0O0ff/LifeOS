{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "varlock run -- nest build",
    "deploy": "varlock run -- nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "varlock run -- nest start",
    "dev": "varlock run -- nest start --watch",
    "start:dev": "varlock run -- nest start --watch",
    "start:debug": "varlock run -- nest start --debug --watch",
    "start:prod": "varlock run -- node dist/main",
    "lint": "oxlint src/ test/",
    "test": "varlock run -- vitest run",
    "test:watch": "varlock run -- vitest",
    "test:cov": "varlock run -- vitest run --coverage",
    "test:debug": "varlock run -- vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "varlock run -- vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@life-os/auth": "workspace:*",
    "@life-os/db": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "@varlock/bitwarden-plugin": "catalog:",
    "@varlock/vite-integration": "^1.5.2",
    "better-auth": "catalog:",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
